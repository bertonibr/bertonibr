<Project Sdk="Microsoft.NET.Sdk">

  <!-- RobotStudio 2025 = .NET Framework 4.8 (a partir do 2026.1 os add-ins passam a .NET 10). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RsMcp.AddIn</AssemblyName>
    <RootNamespace>RsMcp.AddIn</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ajuste se o RobotStudio estiver em outra pasta. -->
    <RobotStudioBin Condition="'$(RobotStudioBin)' == ''">C:\Program Files (x86)\ABB\RobotStudio 2025\Bin</RobotStudioBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="ABB.Robotics.Math">
      <HintPath>$(RobotStudioBin)\ABB.Robotics.Math.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.RobotStudio">
      <HintPath>$(RobotStudioBin)\ABB.Robotics.RobotStudio.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.RobotStudio.Environment">
      <HintPath>$(RobotStudioBin)\ABB.Robotics.RobotStudio.Environment.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.RobotStudio.Stations">
      <HintPath>$(RobotStudioBin)\ABB.Robotics.RobotStudio.Stations.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.RobotStudio.Stations.Forms">
      <HintPath>$(RobotStudioBin)\ABB.Robotics.RobotStudio.Stations.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ABB.Robotics.Controllers.PC">
      <HintPath>$(RobotStudioBin)\ABB.Robotics.Controllers.PC.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="RsMcp.AddIn.rsaddin" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Instrucoes.md" LogicalName="RsMcp.Instrucoes.md" />
    <EmbeddedResource Include="gerar_fechamento.py" LogicalName="RsMcp.gerar_fechamento.py" />
  </ItemGroup>

</Project>
